# ==============================================================================
# Tech Accessories Storefront - Environment Configuration Template
# ==============================================================================
# IMPORTANT:
# - Never commit real secret keys or production credentials to git.
# - Copy this file to '.env' for local configuration.
# - In serverless/container deployments, set these as system environment variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# Store Branding & Localization
# ------------------------------------------------------------------------------
VITE_STORE_NAME="Glacial Tech"
VITE_STORE_TAGLINE="Precision Mobile Accessories"
VITE_DEFAULT_CURRENCY="BDT"
VITE_CURRENCY_SYMBOL="৳"

# ------------------------------------------------------------------------------
# Admin Console Security
# ------------------------------------------------------------------------------
# Strong passcode for the /api/admin/* dashboard
ADMIN_PASSWORD="change_me_in_production_strong_secret"

# Secret used to sign admin HMAC-SHA256 session tokens
ADMIN_SESSION_SECRET="generate_a_random_32_char_secret_for_sessions"

# ------------------------------------------------------------------------------
# Payment Gateway Selection
# ------------------------------------------------------------------------------
# Preferred online gateway: 'sslcommerz', 'bkash', or leave blank for auto-detection.
# If credentials below are missing, the server automatically defaults to the safe
# isolated Sandbox provider with HMAC verification and explicit sandbox warning.
PAYMENT_GATEWAY_PROVIDER="sslcommerz"

# ------------------------------------------------------------------------------
# SSLCommerz Payment Gateway (Multi-Channel: bKash, Nagad, Visa, Mastercard, AMEX)
# Official documentation: https://developer.sslcommerz.com/doc/v4/
# ------------------------------------------------------------------------------
SSLCOMMERZ_STORE_ID="your_sslcommerz_store_id"
SSLCOMMERZ_STORE_PASSWD="your_sslcommerz_store_password"
# Set to 'false' in production for live financial transactions:
SSLCOMMERZ_IS_SANDBOX=true

# ------------------------------------------------------------------------------
# bKash Tokenized Checkout (Direct bKash Integration)
# Official documentation: https://developer.bka.sh/
# ------------------------------------------------------------------------------
BKASH_APP_KEY="your_bkash_app_key"
BKASH_APP_SECRET="your_bkash_app_secret"
BKASH_USERNAME="your_bkash_merchant_username"
BKASH_PASSWORD="your_bkash_merchant_password"
# Set to 'false' for live merchant bKash transactions:
BKASH_IS_SANDBOX=true

# ------------------------------------------------------------------------------
# Developer Sandbox Gateway (Local Testing)
# ------------------------------------------------------------------------------
SANDBOX_SIGNING_SECRET="local_dev_sandbox_hmac_signing_key_replace_for_staging"
