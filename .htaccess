PassengerAppRoot /home/u419193925/domains/tech.vartualtutor.com/server_app
PassengerAppType node
PassengerNodejs /opt/alt/alt-nodejs22/root/bin/node
PassengerStartupFile server.js
PassengerBaseURI /
PassengerRestartDir /home/u419193925/domains/tech.vartualtutor.com/server_app/tmp
SetEnv LSNODE_CONSOLE_LOG console.log

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # 1. Allow direct access to existing physical files and directories
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Never rewrite /api requests to index.html; let Passenger / Node handle /api/
  RewriteCond %{REQUEST_URI} ^/api/
  RewriteRule ^ - [L]

  # 3. Check if requested static file or directory exists inside dist/ (if served from repo root)
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f [OR]
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -d
  RewriteRule ^(.*)$ dist/$1 [L]

  # 4. SPA Fallback: Rewrite non-API deep links to dist/index.html or index.html
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
  RewriteRule . /dist/index.html [L]

  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Fallback error document for non-API routes
<IfModule !mod_rewrite.c>
  ErrorDocument 404 /index.html
</IfModule>
