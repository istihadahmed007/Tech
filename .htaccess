# Glacial Tech - Apache / LiteSpeed SPA Rewrite Configuration
# Enables clean Single Page Application (SPA) routing for /product/:id and other deep links

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Allow direct access to existing files and directories
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # If Apache has mod_proxy and Node.js is running locally on port 3000
  <IfModule mod_proxy.c>
    RewriteCond %{REQUEST_URI} ^/api/
    RewriteRule ^api/(.*)$ http://127.0.0.1:3000/api/$1 [P,L]
  </IfModule>

  # Do NOT rewrite /api/ requests to index.html
  RewriteCond %{REQUEST_URI} !^/api/
  
  # Rewrite all other frontend paths to index.html
  RewriteRule . /index.html [L]
</IfModule>

# Fallback error document to index.html for servers/subdomains without mod_rewrite
ErrorDocument 404 /index.html
